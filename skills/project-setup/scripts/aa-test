#!/usr/bin/env bash
# Quiet test runner for an Alliance Auth app.
#
# Alliance Auth's default LOGGING sends DEBUG and INFO to the console, which
# turns every 'manage.py test' into mostly allianceauth.hooks/signals/
# authentication noise - the bulk of what a session reads back for a run that
# only needs OK or the one failing traceback. This drops any line carrying the
# console formatter's '[date] DEBUG|INFO [' marker and nothing else, so a real
# traceback, a WARNING or an ERROR still comes through. Not line-anchored on
# purpose: the runner's progress dots have no newline of their own, so a log
# line often lands stuck to a preceding dot.
#
# Usage: aa-test <label> [--fresh] [extra manage.py test args...]
#   aa-test my_app                      -> whole suite, quiet
#   aa-test my_app.tests.test_views     -> one module
#   aa-test my_app --fresh              -> rebuild the test database first
#   aa-test my_app --tag translations   -> extra args pass straight through
#
# Configuration, from the environment (e.g. exported in ~/.profile):
#   AA_INSTANCE  directory with manage.py  (default ~/aa-dev/working/myauth)
#   AA_PYTHON    Python of the AA venv     (default ~/aa-dev/venv/bin/python)
#
# Each project gets its own test database (test_<repo name>, via EOS_TEST_DB,
# which the instance's settings read), so runs in different projects never
# rebuild or clone each other's. An EOS_TEST_DB already set wins - use it for
# a second session in the same project.
#
# --keepdb by default: building the test database runs every migration of the
# whole instance - on MySQL 70 to 100 seconds per run, against a few seconds
# for one module's tests, so the first run in a project builds it, later ones
# reuse it. Django still applies a new migration to a
# kept database; what it cannot see is a migration rewritten after it was
# applied, another branch's schema, or a new migration in --parallel clones.
# --fresh rebuilds it; the suite at /commit runs with it.

instance="${AA_INSTANCE:-$HOME/aa-dev/working/myauth}"
python="${AA_PYTHON:-$HOME/aa-dev/venv/bin/python}"

if [ "$#" -eq 0 ]; then
    echo "usage: aa-test <app or test label> [--fresh] [manage.py test args...]" >&2
    exit 2
fi
if [ -z "${EOS_TEST_DB:-}" ]; then
    project="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
    export EOS_TEST_DB="test_${project//-/_}"
fi
cd "$instance" || { echo "aa-test: AA_INSTANCE '$instance' not found" >&2; exit 2; }

keep=(--keepdb)
args=()
for arg in "$@"; do
    if [ "$arg" = "--fresh" ]; then
        keep=()
    else
        args+=("$arg")
    fi
done

"$python" manage.py test "${args[@]}" --noinput "${keep[@]}" 2>&1 \
    | grep -Ev '\[[0-9]{2}/[A-Za-z]{3}/[0-9]{4} [0-9:]{8}\] (DEBUG|INFO) \['
# grep's status only says whether any line survived the filter; the caller
# needs to know whether the tests passed.
exit "${PIPESTATUS[0]}"
